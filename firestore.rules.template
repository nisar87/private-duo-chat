rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the two accounts listed here can read or write anything.
    // __UID_A__ and __UID_B__ are filled in by `npm run rules:render`
    // from config/accounts.json (which is not committed).
    function isMember() {
      return request.auth != null
        && request.auth.uid in ['__UID_A__', '__UID_B__'];
    }

    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'displayName', 'publicKey', 'wrappedPrivateKey', 'wrapNonce',
             'kdfSalt', 'kdfIterations', 'keyVersion',
             'verifiedPeer', 'quickCodeEnc', 'lastReadAt'])
        && request.resource.data.keys().hasAll([
             'displayName', 'publicKey', 'wrappedPrivateKey', 'wrapNonce',
             'kdfSalt', 'kdfIterations', 'keyVersion'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() < 400
        && request.resource.data.wrappedPrivateKey is string
        && request.resource.data.wrappedPrivateKey.size() < 2000
        && request.resource.data.kdfIterations is int
        && request.resource.data.keyVersion is int;
      allow delete: if false;
    }

    // Chat-wide setting: how long messages live.
    match /chats/main {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['retentionMs', 'updatedBy'])
        && request.resource.data.retentionMs in [300000, 3600000, 21600000, 86400000, 604800000, 2592000000]
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /chats/main/messages/{messageId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly([
             'senderUid', 'ciphertext', 'nonce',
             'keyVersion', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasAll([
             'senderUid', 'ciphertext', 'nonce',
             'keyVersion', 'createdAt', 'expireAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        // 30 days (the longest choice) plus 1 hour of slack for clock differences
        && request.resource.data.expireAt <= request.time + duration.value(721, 'h')
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() < 20000
        && request.resource.data.nonce is string
        && request.resource.data.nonce.size() < 64
        && request.resource.data.keyVersion is string
        && request.resource.data.keyVersion.size() < 64;
      allow update: if false;
      allow delete: if isMember();
    }

    // Everything else is denied.
  }
}
