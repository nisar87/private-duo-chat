# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# These values are not secrets (they identify the project), but .env stays out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check (reCAPTCHA Enterprise site key). Leave empty while developing.
VITE_RECAPTCHA_SITE_KEY=

# Neutral tab title. Never use the word "chat".
VITE_APP_TITLE=Notes
